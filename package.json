{
	"name": "annotation-manager",
	"version": "1.1.10",
	"description": "Annotate text inline with {={id}text=} syntax, view all annotations in a sidebar, and query them via Dataview.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
	},
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^16.11.6",
		"esbuild": "0.25.5",
		"tslib": "2.4.0",
		"typescript": "^5.8.3"
	},
	"dependencies": {
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"obsidian": "1.12.7"
	}
}
