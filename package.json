{
	"name": "annotation-manager",
	"version": "1.1.25",
	"description": "Annotate text inline with {={id}text=} syntax, view all annotations in a sidebar, and query them via Dataview.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint src",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@eslint/json": "^2.0.1",
		"@types/node": "^26.2.0",
		"@vitest/coverage-v8": "^4.1.10",
		"esbuild": "0.28.2",
		"eslint": "^10.8.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"prettier": "^3.9.6",
		"tslib": "2.8.1",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.61.0",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@codemirror/state": "6.6.0",
		"@codemirror/view": "6.43.1",
		"obsidian": "1.8.7"
	}
}
